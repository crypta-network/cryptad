<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- Log directory comes from LoggingConfigHandler via system property. -->
  <property name="LOG_DIR" value="${crypta.log.dir:-${user.dir}/logs}"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <immediateFlush>true</immediateFlush>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>WARN</level>
    </filter>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger - %msg%n</pattern>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/crypta-latest.log</file>
    <append>true</append>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger - %msg%n</pattern>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <!-- crypta-YYYY-MM-DD_HH.i.log.gz -->
      <fileNamePattern>${LOG_DIR}/crypta-%d{yyyy-MM-dd_HH}.%i.log.gz</fileNamePattern>
      <!-- Keep roughly on par with FileLoggerHook default budget -->
      <maxHistory>30</maxHistory>
      <totalSizeCap>1GB</totalSizeCap>
      <maxFileSize>20MB</maxFileSize>
      <cleanHistoryOnStart>true</cleanHistoryOnStart>
    </rollingPolicy>
  </appender>

  <!-- Non-blocking async wrapper for FILE -->
  <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>8192</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>true</neverBlock>
    <appender-ref ref="FILE"/>
  </appender>

  <appender name="UID_TRACE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/crypta-uidtrace-latest.log</file>
    <append>true</append>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger - %msg%n</pattern>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/crypta-uidtrace-%d{yyyy-MM-dd_HH}.%i.log.gz</fileNamePattern>
      <maxHistory>30</maxHistory>
      <totalSizeCap>1GB</totalSizeCap>
      <maxFileSize>20MB</maxFileSize>
      <cleanHistoryOnStart>true</cleanHistoryOnStart>
    </rollingPolicy>
  </appender>

  <appender name="ASYNC_UID_TRACE" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>8192</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>true</neverBlock>
    <appender-ref ref="UID_TRACE_FILE"/>
  </appender>

  <logger name="network.crypta.uidtrace" level="OFF" additivity="false">
    <appender-ref ref="ASYNC_UID_TRACE"/>
  </logger>

  <!-- Default root level is WARN; runtime changes are applied by LoggingConfigHandler. -->
  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="ASYNC_FILE"/>
  </root>
</configuration>
