#!/bin/sh
set -e

# jpackage DEB post-remove script

SERVICE_DST="/etc/systemd/system/cryptad.service"
DESKTOP_DST="/usr/share/applications/crypta.desktop"

cleanup_desktop() {
  rm -f "$DESKTOP_DST" || true
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
    update-desktop-database -q /usr/local/share/applications || true
  fi
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor || true
  fi
}

cleanup_service() {
  if command -v systemctl >/dev/null 2>&1; then
    # Only attempt to disable/stop when the unit actually exists to avoid
    # noisy "Unit cryptad.service does not exist" messages during uninstall.
    if systemctl list-unit-files cryptad.service --no-legend --no-pager 2>/dev/null | awk '{print $1}' | grep -qx 'cryptad.service'; then
      systemctl disable --now cryptad.service >/dev/null 2>&1 || true
    fi
    rm -f "$SERVICE_DST" || true
    systemctl daemon-reload || true
  else
    rm -f "$SERVICE_DST" || true
  fi
}

# We clean up both; presence checks ensure idempotency.
cleanup_desktop
cleanup_service

exit 0
