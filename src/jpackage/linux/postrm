#!/bin/sh
set -e

# jpackage DEB post-remove script

SERVICE_DST="/etc/systemd/system/cryptad.service"
DESKTOP_DST="/usr/share/applications/crypta.desktop"

cleanup_desktop() {
  rm -f "$DESKTOP_DST" || true
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
    update-desktop-database -q /usr/local/share/applications || true
  fi
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor || true
  fi
}

cleanup_service() {
  if command -v systemctl >/dev/null 2>&1; then
    # Prefer state probes over listing files to avoid TOCTOU between check and action.
    # If the unit is enabled OR currently active, try disabling+stopping quietly; ignore errors.
    if systemctl is-enabled cryptad.service >/dev/null 2>&1 \
       || systemctl is-active cryptad.service >/dev/null 2>&1; then
      systemctl disable --now cryptad.service >/dev/null 2>&1 || true
    fi
    rm -f "$SERVICE_DST" || true
    systemctl daemon-reload || true
  else
    rm -f "$SERVICE_DST" || true
  fi
}

# We clean up both; presence checks ensure idempotency.
cleanup_desktop
cleanup_service

exit 0
