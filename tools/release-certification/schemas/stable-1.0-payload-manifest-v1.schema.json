{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stable-1.0-payload-manifest-v1",
  "title": "Crypta Stable 1.0 canonical package payload manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "subjectKey", "publishedSubjectDigest", "packageType", "normalizationRuleId", "normalizationRuleVersion", "preSigningPayloadDigest", "packageMetadataDigest", "entries", "ignoredPaths", "limits", "manifestDigest"],
  "properties": {
    "schemaVersion": {"const": 1}, "kind": {"const": "stable-1.0-payload-manifest"},
    "subjectKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$", "maxLength": 128},
    "publishedSubjectDigest": {"$ref": "#/$defs/digest"},
    "packageType": {"enum": ["app-zip", "deb", "dmg", "exe", "flatpak", "jar", "rpm", "snap", "tar", "wheel", "zip"]},
    "normalizationRuleId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$", "maxLength": 128},
    "normalizationRuleVersion": {"type": "integer", "minimum": 1, "maximum": 32},
    "preSigningPayloadDigest": {"$ref": "#/$defs/digest"},
    "packageMetadataDigest": {"$ref": "#/$defs/digest"},
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 1000000, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "kind", "digest", "size", "modeClass", "symlinkTarget", "componentIds"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@/ -]*$", "maxLength": 1024},
          "kind": {"enum": ["file", "directory", "symlink"]},
          "digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
          "size": {"type": "integer", "minimum": 0, "maximum": 100000000000},
          "modeClass": {"enum": ["executable", "read-only", "regular", "directory", "symlink"]},
          "symlinkTarget": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024},
          "componentIds": {
            "type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^pkg:[a-z0-9.+-]+/[A-Za-z0-9._~%+@/?=&-]+$", "maxLength": 512}
          }
        },
        "oneOf": [
          {"properties": {"kind": {"const": "file"}, "modeClass": {"enum": ["executable", "read-only", "regular"]}}},
          {"properties": {"kind": {"const": "directory"}, "modeClass": {"const": "directory"}}},
          {"properties": {"kind": {"const": "symlink"}, "modeClass": {"const": "symlink"}}}
        ]
      }
    },
    "ignoredPaths": {"type": "array", "maxItems": 0, "items": {"type": "string", "maxLength": 1024}},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["entryCount", "expandedBytes", "nestedArchiveDepth"],
      "properties": {
        "entryCount": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "expandedBytes": {"type": "integer", "minimum": 0, "maximum": 100000000000},
        "nestedArchiveDepth": {"type": "integer", "minimum": 0, "maximum": 8}
      }
    },
    "manifestDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71}}
}
