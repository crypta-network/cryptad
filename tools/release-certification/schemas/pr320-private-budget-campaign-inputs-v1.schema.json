{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pr320-private-budget-campaign-inputs-v1.schema.json",
  "title": "Private prospective journal contract; native and original owners impose additional validation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "campaignId",
    "members"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "kind": {
      "const": "pr320-private-budget-campaign-inputs"
    },
    "campaignId": {
      "const": "pr320-budget-full-cohort-v1"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "member",
          "kind",
          "plannedVariants",
          "collectorDigest",
          "configurationDigest",
          "producerDigest"
        ],
        "properties": {
          "member": {
            "type": "string",
            "pattern": "^member-[0-9]{2}\\.json$"
          },
          "kind": {
            "enum": [
              "route-component",
              "storage-component",
              "legacy-attachment",
              "installed-privacy",
              "installed-browser-privacy",
              "artifact-privacy"
            ]
          },
          "plannedVariants": {
            "type": "array",
            "minItems": 1,
            "maxItems": 31,
            "uniqueItems": true,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              }
            }
          },
          "collectorDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "configurationDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "producerDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "servedScriptDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "oneOf": [
          {
            "required": [
              "servedScriptDigest"
            ],
            "properties": {
              "kind": {
                "const": "installed-browser-privacy"
              }
            }
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "route-component",
                  "storage-component",
                  "legacy-attachment",
                  "installed-privacy",
                  "artifact-privacy"
                ]
              },
              "servedScriptDigest": {
                "type": "null"
              }
            }
          }
        ]
      }
    }
  }
}
