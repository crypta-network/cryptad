{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stable-1.0-release-subject-inventory-v1",
  "title": "Crypta Stable 1.0 release subject inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "releaseId", "buildVersion", "sourceCommit", "policyDigest", "componentInventoryDigest", "subjects", "subjectInventoryDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "stable-1.0-release-subject-inventory"},
    "releaseId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128},
    "buildVersion": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$", "maxLength": 40},
    "policyDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
    "componentInventoryDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
    "subjects": {
      "type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["subjectKey", "subjectClass", "fileName", "digest", "size", "reproducibilityClass", "payloadManifestDigest", "componentIds", "app", "catalogEdition", "signatureReceiptDigest", "notarizationReceiptDigest", "packageMetadataDigest"],
        "properties": {
          "subjectKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$", "maxLength": 128},
          "subjectClass": {"enum": ["core", "portable", "runtime-image", "installer", "updater", "catalog", "first-party-app", "app-metadata", "companion-artifact", "publication-material"]},
          "fileName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@/-]*$", "maxLength": 512},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
          "size": {"type": "integer", "minimum": 0, "maximum": 100000000000},
          "reproducibilityClass": {"enum": ["byte-identical", "normalized-payload-identical", "not-a-product-subject"]},
          "payloadManifestDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
          "componentIds": {"type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": {"type": "string", "pattern": "^pkg:[a-z0-9.+-]+/[A-Za-z0-9._~%+@/?=&-]+$", "maxLength": 512}},
          "app": {
            "type": ["object", "null"],
            "oneOf": [
              {"type": "null"},
              {"type": "object", "additionalProperties": false, "required": ["appId", "version", "bundleSignatureDigest", "manifestDigest", "permissionDigest", "staticFilesDigest", "dataSchemaDigest", "contentProfileDigest", "reviewReceiptDigest"], "properties": {
                "appId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "maxLength": 64},
                "version": {"type": "string", "minLength": 1, "maxLength": 64},
                "bundleSignatureDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
                "manifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
                "permissionDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
                "staticFilesDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
                "dataSchemaDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
                "contentProfileDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
                "reviewReceiptDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71}
              }}
            ]
          },
          "catalogEdition": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128},
          "signatureReceiptDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
          "notarizationReceiptDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
          "packageMetadataDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71}
        }
      }
    },
    "subjectInventoryDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71}
  }
}
