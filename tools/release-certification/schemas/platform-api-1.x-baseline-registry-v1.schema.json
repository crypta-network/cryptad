{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform-api-1.x-baseline-registry-v1.schema.json",
  "title": "Platform API 1.x named-baseline registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["baselineRegistry"],
  "properties": {
    "baselineRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "definitions", "lineage", "registryDigest"],
      "properties": {
        "schemaVersion": {"const": 1},
        "definitions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/definition"}
        },
        "lineage": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {"$ref": "#/$defs/lineage"}
        },
        "registryDigest": {"$ref": "#/$defs/rawDigest"}
      }
    }
  },
  "$defs": {
    "baseline": {"type": "string", "pattern": "^1\\.(?:0|[1-9][0-9]*)$"},
    "rawDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableRawDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/rawDigest"}]},
    "nullableBaseline": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/baseline"}]},
    "nullableText": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
      ]
    },
    "nullableBuild": {
      "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 2147483647}]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "routeFamily", "actionLabel", "requiredCapabilities", "hostOperatorBypassAllowed", "appProcessPrincipalsAllowed", "appBrowserPrincipalsAllowed"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 512},
        "routeFamily": {"type": "string", "minLength": 1, "maxLength": 128},
        "actionLabel": {"type": "string", "minLength": 1, "maxLength": 256},
        "requiredCapabilities": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "hostOperatorBypassAllowed": {"type": "boolean"},
        "appProcessPrincipalsAllowed": {"type": "boolean"},
        "appBrowserPrincipalsAllowed": {"type": "boolean"}
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "predecessorId", "capabilities", "endpoints", "sourceArtifactDigest", "proposalDigest", "reviewDigest", "documentationDigest", "firstCompleteContractVersion", "definitionDigest"],
      "properties": {
        "id": {"$ref": "#/$defs/baseline"},
        "predecessorId": {"$ref": "#/$defs/nullableBaseline"},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/endpoint"}
        },
        "sourceArtifactDigest": {"$ref": "#/$defs/rawDigest"},
        "proposalDigest": {"$ref": "#/$defs/nullableRawDigest"},
        "reviewDigest": {"$ref": "#/$defs/nullableRawDigest"},
        "documentationDigest": {"$ref": "#/$defs/nullableRawDigest"},
        "firstCompleteContractVersion": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "definitionDigest": {"$ref": "#/$defs/rawDigest"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "definitionDigest", "status", "evidenceKind", "evidenceDigest", "activationRelease", "activationBuild", "supportStartedRelease", "supportEndedRelease", "previousLineageDigest", "lineageDigest"],
      "properties": {
        "id": {"$ref": "#/$defs/baseline"},
        "definitionDigest": {"$ref": "#/$defs/rawDigest"},
        "status": {"enum": ["proposed", "candidate", "reviewed", "documented", "active", "deprecated", "end-of-support", "rejected"]},
        "evidenceKind": {"enum": ["imported-frozen-baseline", "fixture", "protected-release"]},
        "evidenceDigest": {"$ref": "#/$defs/rawDigest"},
        "activationRelease": {"$ref": "#/$defs/nullableText"},
        "activationBuild": {"$ref": "#/$defs/nullableBuild"},
        "supportStartedRelease": {"$ref": "#/$defs/nullableText"},
        "supportEndedRelease": {"$ref": "#/$defs/nullableText"},
        "previousLineageDigest": {"$ref": "#/$defs/nullableRawDigest"},
        "lineageDigest": {"$ref": "#/$defs/rawDigest"}
      }
    }
  }
}
