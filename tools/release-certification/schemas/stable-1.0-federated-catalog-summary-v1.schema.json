{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stable-1.0-federated-catalog-summary-v1.schema.json",
  "title": "Stable 1.0 federated catalog summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "executionId", "releaseId", "buildVersion", "sourceCommit", "mode", "status", "state", "implementationComplete", "fixtureVerificationComplete", "discoveryAuthenticated", "localTrustConfigured", "conflictPolicyVerified", "runtimeFederationVerified", "operationalFederationComplete", "fixtureOnly", "selfTest", "operational", "policyDigest", "authorityDigests", "descriptorDigest", "endorsementDigests", "runtimeObservationDigest", "checks", "blockers", "summaryDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "stable-1.0-federated-catalog-summary"},
    "executionId": {"$ref": "#/$defs/id"},
    "releaseId": {"$ref": "#/$defs/id"},
    "buildVersion": {"type": "string", "pattern": "^[1-9][0-9]{0,9}$"},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "mode": {"enum": ["preflight", "verify-discovery", "verify-local-trust", "verify-conflicts", "verify-runtime", "closeout"]},
    "status": {"enum": ["pass", "fail", "partial"]},
    "state": {"enum": ["implementation-complete", "fixture-verification-complete", "discovery-authenticated", "local-trust-configured", "conflict-policy-verified", "runtime-federation-verified", "operational-federation-complete", "blocked", "partial"]},
    "implementationComplete": {"type": "boolean"},
    "fixtureVerificationComplete": {"type": "boolean"},
    "discoveryAuthenticated": {"type": "boolean"},
    "localTrustConfigured": {"type": "boolean"},
    "conflictPolicyVerified": {"type": "boolean"},
    "runtimeFederationVerified": {"type": "boolean"},
    "operationalFederationComplete": {"type": "boolean"},
    "fixtureOnly": {"type": "boolean"},
    "selfTest": {"type": "boolean"},
    "operational": {"type": "boolean"},
    "policyDigest": {"$ref": "#/$defs/digest"},
    "authorityDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protectedRelease", "independentReproducibility", "catalogAuthority", "thirdPartyPilot"],
      "properties": {
        "protectedRelease": {"$ref": "#/$defs/digest"},
        "independentReproducibility": {"$ref": "#/$defs/digest"},
        "catalogAuthority": {"$ref": "#/$defs/digest"},
        "thirdPartyPilot": {"$ref": "#/$defs/digest"}
      }
    },
    "descriptorDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "endorsementDigests": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "runtimeObservationDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "checks": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/check"}},
    "blockers": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,159}$"}},
    "summaryDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "digest"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,95}$"},
        "status": {"enum": ["pass", "fail", "pending", "fixture-only"]},
        "digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}
      }
    }
  }
}
