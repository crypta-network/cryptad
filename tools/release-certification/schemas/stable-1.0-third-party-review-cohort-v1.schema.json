{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stable-1.0-third-party-review-cohort-v1.schema.json",
  "title": "Protected external third-party review cohort",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "pilotId", "appId", "provenance", "reviewerKeyId", "reviewerFingerprint", "policyId", "policyVersion", "assignmentDigest", "transparencyLogDigest", "transparencyRecordCount", "transparencyHead", "transparencyRecords", "rows", "reviewedAt", "expiresAt", "receiptDigest", "signatureBase64"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "stable-1.0-third-party-review-cohort"},
    "pilotId": {"type": "string"},
    "appId": {"type": "string"},
    "provenance": {"$ref": "stable-1.0-protected-artifact-provenance-v1.schema.json#/$defs/provenance"},
    "reviewerKeyId": {"type": "string"},
    "reviewerFingerprint": {"$ref": "#/$defs/digest"},
    "policyId": {"type": "string"},
    "policyVersion": {"type": "string"},
    "assignmentDigest": {"$ref": "#/$defs/digest"},
    "transparencyLogDigest": {"$ref": "#/$defs/digest"},
    "transparencyRecordCount": {"type": "integer", "minimum": 8, "maximum": 4096},
    "transparencyHead": {"$ref": "#/$defs/digest"},
    "transparencyRecords": {"type": "array", "minItems": 8, "maxItems": 4096, "items": {"$ref": "#/$defs/transparencyRecord"}},
    "rows": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/row"}},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "receiptDigest": {"$ref": "#/$defs/digest"},
    "signatureBase64": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohortId", "submissionId", "submissionDigest", "bundleDigest", "bundleSignatureDigest", "preReviewDigest", "decision", "decisionRecordDigest", "standardReviewReceipt", "standardReviewReceiptDigest", "resubmissionOf", "candidateEligible", "cautionWarnings", "cautionAllowance"],
      "properties": {
        "cohortId": {"type": "string"},
        "submissionId": {"type": "string"},
        "submissionDigest": {"$ref": "#/$defs/digest"},
        "bundleDigest": {"$ref": "#/$defs/digest"},
        "bundleSignatureDigest": {"$ref": "#/$defs/digest"},
        "preReviewDigest": {"$ref": "#/$defs/digest"},
        "decision": {"enum": ["reviewed", "caution", "rejected", "resubmission_requested"]},
        "decisionRecordDigest": {"$ref": "#/$defs/digest"},
        "standardReviewReceipt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/standardReviewReceipt"}]},
        "standardReviewReceiptDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "resubmissionOf": {"type": ["string", "null"]},
        "candidateEligible": {"type": "boolean"},
        "cautionWarnings": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"}},
        "cautionAllowance": {"type": "boolean"}
      }
    },
    "standardReviewReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "appId", "appVersion", "artifactSha256", "artifactSizeBytes", "bundleKeyId", "policyId", "policyVersion", "status", "reviewerKeyId", "reviewedAt", "expiresAt", "evidenceSha256", "decisionReasonSha256", "evidenceUri", "note", "signatureAlgorithm", "signatureBase64"],
      "properties": {
        "version": {"const": 2},
        "appId": {"type": "string"},
        "appVersion": {"type": "string"},
        "artifactSha256": {"$ref": "#/$defs/rawDigest"},
        "artifactSizeBytes": {"type": "integer", "minimum": 1},
        "bundleKeyId": {"type": "string"},
        "policyId": {"type": "string"},
        "policyVersion": {"type": "string"},
        "status": {"enum": ["reviewed", "caution"]},
        "reviewerKeyId": {"type": "string"},
        "reviewedAt": {"type": "string", "format": "date-time"},
        "expiresAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "evidenceSha256": {"$ref": "#/$defs/rawDigest"},
        "decisionReasonSha256": {"$ref": "#/$defs/rawDigest"},
        "evidenceUri": {"type": "null"},
        "note": {"type": ["string", "null"], "maxLength": 512},
        "signatureAlgorithm": {"const": "Ed25519"},
        "signatureBase64": {"$ref": "#/$defs/signature"}
      }
    },
    "transparencyRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "sequence", "recordId", "createdAt", "kind", "subjectType", "appId", "appVersion", "catalogId", "artifactSha256", "artifactSizeBytes", "reviewerKeyId", "reviewerKeyStatus", "policyId", "policyVersion", "receiptStatus", "trustStatus", "trusted", "positive", "requiresAcknowledgement", "blocksInstall", "blocksUpdate", "blocksPolicyApply", "evidenceSha256", "evidenceUri", "previousRecordHash", "recordHash", "warnings"],
      "properties": {
        "schemaVersion": {"const": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "recordId": {"type": "string", "minLength": 1, "maxLength": 512},
        "createdAt": {"type": "string", "format": "date-time"},
        "kind": {"enum": ["review_receipt_observed", "submission_created", "reviewer_assigned", "pre_review_completed", "review_decision_recorded", "review_receipt_issued", "submission_rejected", "submission_resubmitted", "catalog_candidate_created", "review_trust_evaluated", "review_gate_install", "review_gate_update", "review_gate_policy_apply", "reviewer_registry_loaded", "reviewer_key_active", "reviewer_key_retired", "reviewer_key_revoked", "reviewer_key_rotated", "transparency_log_verified"]},
        "subjectType": {"type": ["string", "null"], "maxLength": 64},
        "appId": {"type": ["string", "null"], "maxLength": 512},
        "appVersion": {"type": ["string", "null"], "maxLength": 512},
        "catalogId": {"type": ["string", "null"], "maxLength": 512},
        "artifactSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/rawDigest"}]},
        "artifactSizeBytes": {"type": ["integer", "null"], "minimum": 0},
        "reviewerKeyId": {"type": ["string", "null"], "maxLength": 512},
        "reviewerKeyStatus": {"type": ["string", "null"], "maxLength": 512},
        "policyId": {"type": ["string", "null"], "maxLength": 512},
        "policyVersion": {"type": ["string", "null"], "maxLength": 512},
        "receiptStatus": {"type": ["string", "null"], "maxLength": 512},
        "trustStatus": {"type": ["string", "null"], "maxLength": 512},
        "trusted": {"type": ["boolean", "null"]},
        "positive": {"type": ["boolean", "null"]},
        "requiresAcknowledgement": {"type": ["boolean", "null"]},
        "blocksInstall": {"type": ["boolean", "null"]},
        "blocksUpdate": {"type": ["boolean", "null"]},
        "blocksPolicyApply": {"type": ["boolean", "null"]},
        "evidenceSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/rawDigest"}]},
        "evidenceUri": {"type": ["string", "null"], "maxLength": 1024},
        "previousRecordHash": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
        "recordHash": {"$ref": "#/$defs/rawDigest"},
        "warnings": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 256}}
      }
    },
    "rawDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
