{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stable-1.0-reproducibility-result-v1",
  "title": "Crypta Stable 1.0 reproducibility result",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "releaseId", "buildVersion", "tag", "sourceCommit", "sourceRef", "policyDigest", "comparisonPlanDigest", "primaryBuilderReceiptDigest", "verifierBuilderReceiptDigest", "comparisons", "status", "unexplainedDifferences", "resultDigest"],
  "properties": {
    "schemaVersion": {"const": 1}, "kind": {"const": "stable-1.0-reproducibility-result"},
    "releaseId": {"type": "string", "minLength": 1, "maxLength": 128}, "buildVersion": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "tag": {"type": "string", "pattern": "^v[1-9][0-9]*$", "maxLength": 32}, "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$", "maxLength": 40},
    "sourceRef": {"type": "string", "pattern": "^(refs/(heads|tags)/[A-Za-z0-9._/-]+|commit:[0-9a-f]{40})$", "maxLength": 512},
    "policyDigest": {"$ref": "#/$defs/digest"}, "comparisonPlanDigest": {"$ref": "#/$defs/digest"}, "primaryBuilderReceiptDigest": {"$ref": "#/$defs/digest"}, "verifierBuilderReceiptDigest": {"$ref": "#/$defs/digest"},
    "comparisons": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["subjectKey", "reproducibilityClass", "status", "primaryDigest", "verifierDigest", "primaryPayloadManifestDigest", "verifierPayloadManifestDigest", "differences"], "properties": {
      "subjectKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$", "maxLength": 128}, "reproducibilityClass": {"enum": ["byte-identical", "normalized-payload-identical"]},
      "status": {"enum": ["pass", "fail"]}, "primaryDigest": {"$ref": "#/$defs/digest"}, "verifierDigest": {"$ref": "#/$defs/digest"},
      "primaryPayloadManifestDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71}, "verifierPayloadManifestDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
      "differences": {"type": "array", "minItems": 0, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
    }}},
    "status": {"enum": ["pass", "fail"]}, "unexplainedDifferences": {"type": "integer", "minimum": 0, "maximum": 65536}, "resultDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71}}
}
