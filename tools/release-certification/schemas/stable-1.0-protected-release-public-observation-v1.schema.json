{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stable-1.0-protected-release-public-observation-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "repositoryIdentity",
    "releaseId",
    "buildVersion",
    "candidateCommit",
    "publicationReceiptDigest",
    "productDigest",
    "observedAt",
    "observer",
    "tag",
    "githubRelease",
    "targets",
    "status",
    "fixture",
    "redaction"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "stable-1.0-protected-release-public-observation"},
    "repositoryIdentity": {"const": "github.com/crypta-network/cryptad"},
    "releaseId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "buildVersion": {"type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 10},
    "candidateCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "publicationReceiptDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "productDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observedAt": {"type": "string", "format": "date-time"},
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflowPath", "workflowCommit", "runId", "runAttempt", "artifactName", "environment", "conclusion", "readOnly"],
      "properties": {
        "repository": {"const": "crypta-network/cryptad"},
        "workflowPath": {"type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.yml$"},
        "workflowCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "runId": {"type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 20},
        "runAttempt": {"type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 10},
        "artifactName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$", "maxLength": 128},
        "environment": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"},
        "conclusion": {"const": "success"},
        "readOnly": {"const": true}
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "targetCommit", "annotated", "status"],
      "properties": {
        "name": {"type": "string", "pattern": "^v[1-9][0-9]*$", "maxLength": 32},
        "targetCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "annotated": {"const": true},
        "status": {"const": "observed-exact"}
      }
    },
    "githubRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "publicUrl", "name", "tagName", "targetCommitish", "draft", "prerelease", "releaseNotesDigest", "status"],
      "properties": {
        "releaseId": {"type": "integer", "minimum": 1},
        "publicUrl": {"type": "string", "format": "uri", "maxLength": 2048},
        "name": {"type": "string", "pattern": "^Cryptad Stable 1\\.0 \\(v[1-9][0-9]*\\)$", "maxLength": 64},
        "tagName": {"type": "string", "pattern": "^v[1-9][0-9]*$", "maxLength": 32},
        "targetCommitish": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "draft": {"const": false},
        "prerelease": {"const": false},
        "releaseNotesDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "status": {"const": "observed-exact"}
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "publicUri", "sha256", "size", "status"],
        "properties": {
          "role": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"},
          "publicUri": {"type": "string", "format": "uri", "maxLength": 2048},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0},
          "status": {"const": "observed-exact"}
        }
      }
    },
    "status": {"const": "pass"},
    "fixture": {"const": false},
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "findingCount", "findings"],
      "properties": {
        "status": {"const": "pass"},
        "findingCount": {"const": 0},
        "findings": {"type": "array", "maxItems": 0}
      }
    }
  }
}
