{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stable-1.0-component-reverse-index-v1",
  "title": "Crypta Stable 1.0 component reverse index",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "releaseId", "buildVersion", "tag", "sourceCommit", "sourceRef", "policyDigest", "componentInventoryDigest", "subjectInventoryDigest", "entries", "reverseIndexDigest"],
  "properties": {
    "schemaVersion": {"const": 1}, "kind": {"const": "stable-1.0-component-reverse-index"},
    "releaseId": {"type": "string", "minLength": 1, "maxLength": 128}, "buildVersion": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "tag": {"type": "string", "pattern": "^v[1-9][0-9]*$", "maxLength": 32}, "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$", "maxLength": 40},
    "sourceRef": {"type": "string", "pattern": "^(refs/(heads|tags)/[A-Za-z0-9._/-]+|commit:[0-9a-f]{40})$", "maxLength": 512},
    "policyDigest": {"$ref": "#/$defs/digest"}, "componentInventoryDigest": {"$ref": "#/$defs/digest"}, "subjectInventoryDigest": {"$ref": "#/$defs/digest"},
    "entries": {"type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["componentId", "version", "digest", "runtimeComponentIds", "stableBuilds", "subjectKeys", "apps", "catalogEditions"], "properties": {
      "componentId": {"type": "string", "pattern": "^pkg:[a-z0-9.+-]+/[A-Za-z0-9._~%+@/?=&-]+$", "maxLength": 512}, "version": {"type": "string", "minLength": 1, "maxLength": 128},
      "digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
      "runtimeComponentIds": {"type": "array", "minItems": 0, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,127}$", "maxLength": 128}},
      "stableBuilds": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 2147483647}},
      "subjectKeys": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$", "maxLength": 128}},
      "apps": {"type": "array", "minItems": 0, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}@[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$", "maxLength": 128}},
      "catalogEditions": {"type": "array", "minItems": 0, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128}}
    }}},
    "reverseIndexDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71}}
}
