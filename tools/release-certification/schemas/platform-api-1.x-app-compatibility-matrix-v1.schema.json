{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform-api-1.x-app-compatibility-matrix-v1.schema.json",
  "title": "Platform API 1.x app compatibility matrix",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "releaseId", "sourceCommit", "staticOnly", "requiredAppIds", "rows", "appSubjectsDigest", "matrixDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "platform-api-1.x-app-compatibility-matrix"},
    "releaseId": {"$ref": "#/$defs/id"},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "staticOnly": {"const": true},
    "requiredAppIds": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "rows": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/row"}},
    "appSubjectsDigest": {"$ref": "#/$defs/digest"},
    "matrixDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["releaseRole", "releaseId", "contractVersion", "baselineId", "verdict", "staticVerified", "runtimeObserved", "findingCodes"],
      "properties": {
        "releaseRole": {"enum": ["oldest-supported", "previous", "candidate", "preview"]},
        "releaseId": {"$ref": "#/$defs/id"},
        "contractVersion": {"type": "integer", "minimum": 19},
        "baselineId": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^1\\.(?:0|[1-9][0-9]*)$"}]},
        "verdict": {"enum": ["compatible", "compatible-with-warnings", "incompatible", "unsupported-baseline", "outside-tested-range", "preview-only", "untested", "blocked"]},
        "staticVerified": {"type": "boolean"},
        "runtimeObserved": {"const": false},
        "findingCodes": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"}}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["appId", "appVersion", "bundleDigest", "manifestDigest", "publisherId", "catalogId", "reviewDigest", "targetStability", "targetBaseline", "minimumContractVersion", "maximumTestedContractVersion", "requiredCapabilities", "optionalCapabilities", "experimentalCapabilitiesAccepted", "sourceAuthority", "fixtureOnly", "requiredForRelease", "evaluations"],
      "properties": {
        "appId": {"$ref": "#/$defs/id"},
        "appVersion": {"$ref": "#/$defs/id"},
        "bundleDigest": {"$ref": "#/$defs/digest"},
        "manifestDigest": {"$ref": "#/$defs/digest"},
        "publisherId": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "catalogId": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "reviewDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "targetStability": {"enum": ["legacy", "stable", "experimental"]},
        "targetBaseline": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^1\\.(?:0|[1-9][0-9]*)$"}]},
        "minimumContractVersion": {"type": "integer", "minimum": 1},
        "maximumTestedContractVersion": {"type": "integer", "minimum": 1},
        "requiredCapabilities": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "optionalCapabilities": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "experimentalCapabilitiesAccepted": {"type": "boolean"},
        "sourceAuthority": {"enum": ["first-party-release", "third-party-pilot", "federated-catalog", "fixture"]},
        "fixtureOnly": {"type": "boolean"},
        "requiredForRelease": {"type": "boolean"},
        "evaluations": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/evaluation"}}
      }
    }
  }
}
