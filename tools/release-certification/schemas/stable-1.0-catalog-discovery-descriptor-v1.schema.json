{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stable-1.0-catalog-discovery-descriptor-v1.schema.json",
  "title": "Stable 1.0 catalog discovery descriptor runtime wire format",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "descriptorId", "subject", "display", "transparency", "validity", "issuer", "selfDigestSha256", "signature"],
  "properties": {
    "schemaVersion": {"const": 1},
    "descriptorId": {"$ref": "#/$defs/id"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogId", "signerKeyId", "signerFingerprintSha256", "sourceHints", "channels"],
      "properties": {
        "catalogId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "signerKeyId": {"$ref": "#/$defs/id"},
        "signerFingerprintSha256": {"$ref": "#/$defs/runtimeDigest"},
        "sourceHints": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/publicUri"}},
        "channels": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[^\\r\\n]+$"}}
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "providerId"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\r\\n]+$"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n]+$"},
        "providerId": {"$ref": "#/$defs/id"}
      }
    },
    "transparency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewerSetDigestSha256": {"$ref": "#/$defs/runtimeDigest"},
        "reviewerSetUri": {"$ref": "#/$defs/publicUri"},
        "publisherPolicyDigestSha256": {"$ref": "#/$defs/runtimeDigest"},
        "publisherPolicyUri": {"$ref": "#/$defs/publicUri"}
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuedAt", "expiresAt"],
      "properties": {
        "issuedAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "predecessorDigestSha256": {"$ref": "#/$defs/runtimeDigest"},
        "successorDigestSha256": {"$ref": "#/$defs/runtimeDigest"}
      }
    },
    "issuer": {"$ref": "#/$defs/issuer"},
    "selfDigestSha256": {"$ref": "#/$defs/runtimeDigest"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "runtimeDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publicUri": {"type": "string", "minLength": 8, "maxLength": 2048, "pattern": "^(?:crypta:|https://)[^\\r\\n]+$"},
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuerId", "keyId", "keyFingerprintSha256"],
      "properties": {
        "issuerId": {"$ref": "#/$defs/id"},
        "keyId": {"$ref": "#/$defs/id"},
        "keyFingerprintSha256": {"$ref": "#/$defs/runtimeDigest"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "valueBase64"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "valueBase64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    }
  }
}
