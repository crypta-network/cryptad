{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pr320-private-budget-campaign-member-v1.schema.json",
  "description": "Private prospective journal contract. Code-owned experiment roster and native/original owners impose additional validation; this schema grants no authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "campaignId",
    "member",
    "digest",
    "size",
    "collectorEpoch",
    "rawBase64"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "kind": {
      "const": "pr320-private-budget-campaign-member"
    },
    "campaignId": {
      "const": "pr320-budget-full-cohort-v1"
    },
    "member": {
      "type": "string",
      "pattern": "^member-[0-9]{2}\\.json$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8388608
    },
    "collectorEpoch": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "rawBase64": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 699052,
          "contentEncoding": "base64"
        }
      ]
    }
  }
}
