{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stable-1.0-dependency-intelligence-provenance-set-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "repositoryIdentity",
    "stableMilestone",
    "generatedAt",
    "policyDigest",
    "provenances",
    "provenanceSetDigest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "stable-1.0-dependency-intelligence-provenance-set"},
    "repositoryIdentity": {"const": "github.com/crypta-network/cryptad"},
    "stableMilestone": {"const": "Stable 1.0"},
    "generatedAt": {"$ref": "stable-1.0-dependency-vulnerability-common-v1.schema.json#/$defs/timestamp"},
    "policyDigest": {"$ref": "stable-1.0-dependency-vulnerability-common-v1.schema.json#/$defs/digest"},
    "provenances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "stable-1.0-dependency-intelligence-provenance-v1.schema.json"}
    },
    "provenanceSetDigest": {"$ref": "stable-1.0-dependency-vulnerability-common-v1.schema.json#/$defs/digest"}
  }
}
