{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stable-1.0-component-inventory-v1",
  "title": "Crypta Stable 1.0 component inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "releaseId", "buildVersion", "sourceCommit", "policyDigest", "resolvedDependencySnapshotDigest", "components", "inventoryDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "stable-1.0-component-inventory"},
    "releaseId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128},
    "buildVersion": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$", "maxLength": 40},
    "policyDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
    "resolvedDependencySnapshotDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
    "components": {"type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "stable-1.0-component-v1.schema.json"}},
    "inventoryDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71}
  }
}
