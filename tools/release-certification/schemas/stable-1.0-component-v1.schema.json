{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stable-1.0-component-v1",
  "title": "Crypta Stable 1.0 canonical component",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "kind", "componentId", "componentKind", "name", "version",
    "namespace", "purl", "digest", "origin", "resolved", "roles", "relationships",
    "subjectKeys", "apps", "runtimeComponentIds", "license",
    "dependencyVerificationStatus", "buildMaterialStatus", "classification", "recordDigest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "stable-1.0-component"},
    "componentId": {"type": "string", "pattern": "^pkg:[a-z0-9.+-]+/[A-Za-z0-9._~%+@/?=&-]+$", "minLength": 8, "maxLength": 512},
    "componentKind": {"enum": ["maven", "gradle-plugin", "internal-module", "vendored-binary", "vendored-source", "jdk-module", "native", "first-party-app", "web-asset", "packaging-tool", "publication-tool"]},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@/-]*$", "minLength": 1, "maxLength": 160},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$", "minLength": 1, "maxLength": 128},
    "namespace": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$", "minLength": 1, "maxLength": 200},
    "purl": {"type": "string", "pattern": "^pkg:[a-z0-9.+-]+/[A-Za-z0-9._~%+@/?=&-]+$", "minLength": 8, "maxLength": 512},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
    "origin": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "uri", "immutableReference", "provenanceDigest"],
      "properties": {
        "type": {"enum": ["maven-central", "gradle-plugin-portal", "repository-source", "reviewed-vendor", "openjdk", "built-first-party"]},
        "uri": {"type": ["string", "null"], "pattern": "^https://[^\\s]+$", "maxLength": 1024},
        "immutableReference": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+?=%~-]*$", "minLength": 1, "maxLength": 512},
        "provenanceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71}
      }
    },
    "resolved": {
      "type": "object", "additionalProperties": false,
      "required": ["coordinates", "selectedVariant", "attributes"],
      "properties": {
        "coordinates": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
        "selectedVariant": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "attributes": {
          "type": "array", "minItems": 0, "maxItems": 64, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 160},
              "value": {"type": "string", "minLength": 1, "maxLength": 256}
            }
          }
        }
      }
    },
    "roles": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["runtime", "build", "test", "packaging", "publication"]}},
    "relationships": {
      "type": "object", "additionalProperties": false,
      "required": ["direct", "parents", "contains", "dependsOn"],
      "properties": {
        "direct": {"type": "boolean"},
        "parents": {"$ref": "#/$defs/componentIds"},
        "contains": {"$ref": "#/$defs/componentIds"},
        "dependsOn": {"$ref": "#/$defs/componentIds"}
      }
    },
    "subjectKeys": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$", "maxLength": 128}},
    "apps": {
      "type": "array", "minItems": 0, "maxItems": 16, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["appId", "version"],
        "properties": {
          "appId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "maxLength": 64},
          "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$", "maxLength": 64}
        }
      }
    },
    "runtimeComponentIds": {"type": "array", "minItems": 0, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,127}$", "maxLength": 128}},
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["expression", "status", "evidenceDigest", "licenseTextDigest"],
      "properties": {
        "expression": {"type": "string", "minLength": 1, "maxLength": 256},
        "status": {"enum": ["allowed", "allowed-with-notice", "review-required", "prohibited", "unknown-blocking", "not-applicable-internal"]},
        "evidenceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
        "licenseTextDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71}
      }
    },
    "dependencyVerificationStatus": {"enum": ["verified", "unverified", "not-applicable"]},
    "buildMaterialStatus": {"enum": ["verified", "built", "unknown", "not-applicable"]},
    "classification": {"enum": ["public", "protected"]},
    "recordDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71}
  },
  "$defs": {
    "componentIds": {"type": "array", "minItems": 0, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^pkg:[a-z0-9.+-]+/[A-Za-z0-9._~%+@/?=&-]+$", "maxLength": 512}}
  }
}
