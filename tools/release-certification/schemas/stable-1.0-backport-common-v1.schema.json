{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crypta-network/cryptad/tools/release-certification/schemas/stable-1.0-backport-common-v1.schema.json",
  "title": "Cryptad Stable 1.0 backport and release-train common definitions v1",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableDigest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "commitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "nullableCommitOid": {
      "oneOf": [
        {
          "$ref": "#/$defs/commitOid"
        },
        {
          "type": "null"
        }
      ]
    },
    "treeOid": {
      "$ref": "#/$defs/commitOid"
    },
    "nullableTreeOid": {
      "oneOf": [
        {
          "$ref": "#/$defs/treeOid"
        },
        {
          "type": "null"
        }
      ]
    },
    "stablePatchId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "nullableStablePatchId": {
      "oneOf": [
        {
          "$ref": "#/$defs/stablePatchId"
        },
        {
          "type": "null"
        }
      ]
    },
    "objectFormat": {
      "enum": [
        "sha1",
        "sha256"
      ]
    },
    "build": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "releaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "trainId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^stable-train-[A-Za-z0-9][A-Za-z0-9._-]{0,114}$"
    },
    "fixId": {
      "type": "string",
      "pattern": "^stable-fix-[a-z0-9]{16,64}$"
    },
    "queueId": {
      "type": "string",
      "pattern": "^stable-queue-[a-z0-9]{16,64}$"
    },
    "intakeId": {
      "type": "string",
      "pattern": "^stable-intake-[a-z0-9]{16,64}$"
    },
    "repositoryIdentity": {
      "const": "github.com/crypta-network/cryptad"
    },
    "workflowIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^github.com/crypta-network/cryptad/.github/workflows/[A-Za-z0-9._/-]+@[0-9a-f]{40}$"
    },
    "componentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "safeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f<>`]+$"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9-]{0,95}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f-\\u009f<>`])[A-Za-z0-9._+@ /-]+$"
    },
    "classification": {
      "enum": [
        "compatible-bug-fix",
        "security-fix",
        "platform-api-compatible-addition",
        "platform-api-deprecation",
        "stable-catalog-app-patch",
        "packaging-installer-fix",
        "release-tooling-fix",
        "documentation-support-fix",
        "unsupported-feature-change",
        "breaking-change"
      ]
    },
    "disposition": {
      "enum": [
        "routine-maintenance",
        "security-hotfix",
        "future-milestone",
        "deferred",
        "rejected"
      ]
    },
    "releaseLane": {
      "oneOf": [
        {
          "enum": [
            "routine-maintenance",
            "security-hotfix"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "releaseClass": {
      "enum": [
        "maintenance",
        "security-hotfix"
      ]
    },
    "fixState": {
      "enum": [
        "submitted",
        "triaged",
        "accepted",
        "scheduled",
        "landed",
        "verified",
        "released",
        "deferred",
        "rejected",
        "superseded"
      ]
    },
    "provenanceMode": {
      "oneOf": [
        {
          "enum": [
            "inherited",
            "clean-cherry-pick",
            "manual-conflict-resolution"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "branchRole": {
      "enum": [
        "canonical-development",
        "routine-release-candidate",
        "security-hotfix-candidate",
        "authenticated-published-main",
        "authenticated-predecessor"
      ]
    },
    "severity": {
      "enum": [
        "none",
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "risk": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "releaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseId",
        "releaseClass",
        "buildVersion",
        "tag"
      ],
      "properties": {
        "releaseId": {
          "$ref": "#/$defs/releaseId"
        },
        "releaseClass": {
          "$ref": "#/$defs/releaseClass"
        },
        "buildVersion": {
          "$ref": "#/$defs/build"
        },
        "tag": {
          "$ref": "#/$defs/tag"
        }
      }
    },
    "gitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryIdentity",
        "objectFormat",
        "commit"
      ],
      "properties": {
        "repositoryIdentity": {
          "$ref": "#/$defs/repositoryIdentity"
        },
        "objectFormat": {
          "$ref": "#/$defs/objectFormat"
        },
        "commit": {
          "$ref": "#/$defs/commitOid"
        }
      }
    },
    "affectedScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components",
        "packageKeys",
        "appIds",
        "platformApiIds",
        "contentProfileIds",
        "dataSchemaIds",
        "affectedBuilds"
      ],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentId"
          }
        },
        "packageKeys": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentId"
          }
        },
        "appIds": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentId"
          }
        },
        "platformApiIds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentId"
          }
        },
        "contentProfileIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentId"
          }
        },
        "dataSchemaIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentId"
          }
        },
        "affectedBuilds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/build"
          }
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "digest",
        "policyDigest",
        "queueDigest",
        "generatedAt",
        "expiresAt",
        "predecessorCommit",
        "candidateCommit",
        "visibility"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/componentId"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "policyDigest": {
          "$ref": "#/$defs/digest"
        },
        "queueDigest": {
          "$ref": "#/$defs/digest"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "predecessorCommit": {
          "$ref": "#/$defs/nullableCommitOid"
        },
        "candidateCommit": {
          "$ref": "#/$defs/nullableCommitOid"
        },
        "visibility": {
          "enum": [
            "public",
            "protected"
          ]
        }
      }
    },
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "from",
        "to",
        "occurredAt",
        "actorRole",
        "reasonCode",
        "evidenceDigest"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "from": {
          "oneOf": [
            {
              "$ref": "#/$defs/fixState"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "$ref": "#/$defs/fixState"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "actorRole": {
          "$ref": "#/$defs/componentId"
        },
        "reasonCode": {
          "$ref": "#/$defs/reasonCode"
        },
        "evidenceDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryIdentity",
        "objectFormat",
        "sourceCommit",
        "sourceBranchRole"
      ],
      "properties": {
        "repositoryIdentity": {
          "$ref": "#/$defs/repositoryIdentity"
        },
        "objectFormat": {
          "$ref": "#/$defs/objectFormat"
        },
        "sourceCommit": {
          "$ref": "#/$defs/commitOid"
        },
        "sourceBranchRole": {
          "$ref": "#/$defs/branchRole"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "candidateCommit",
        "candidateBranchRole",
        "stablePatchId",
        "sourceTreeOid",
        "sourceTreeDigest",
        "sourceDiffDigest",
        "candidateTreeOid",
        "candidateTreeDigest",
        "candidateDiffDigest",
        "touchedPaths",
        "mergeBaseCommit",
        "sourceBaseCommit",
        "targetBaseCommit",
        "conflictPaths",
        "normalizedDiffEvidenceDigest",
        "reviewerAuthorizationDigest",
        "focusedTestEvidenceIds",
        "noUnrelatedFeatureChange"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/provenanceMode"
        },
        "candidateCommit": {
          "$ref": "#/$defs/nullableCommitOid"
        },
        "candidateBranchRole": {
          "oneOf": [
            {
              "$ref": "#/$defs/branchRole"
            },
            {
              "type": "null"
            }
          ]
        },
        "stablePatchId": {
          "$ref": "#/$defs/nullableStablePatchId"
        },
        "sourceTreeOid": {
          "$ref": "#/$defs/treeOid"
        },
        "sourceTreeDigest": {
          "$ref": "#/$defs/digest"
        },
        "sourceDiffDigest": {
          "$ref": "#/$defs/digest"
        },
        "candidateTreeOid": {
          "$ref": "#/$defs/nullableTreeOid"
        },
        "candidateTreeDigest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "candidateDiffDigest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "touchedPaths": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "mergeBaseCommit": {
          "$ref": "#/$defs/nullableCommitOid"
        },
        "sourceBaseCommit": {
          "$ref": "#/$defs/nullableCommitOid"
        },
        "targetBaseCommit": {
          "$ref": "#/$defs/nullableCommitOid"
        },
        "conflictPaths": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "normalizedDiffEvidenceDigest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "reviewerAuthorizationDigest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "focusedTestEvidenceIds": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentId"
          }
        },
        "noUnrelatedFeatureChange": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "securityScope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "incidentOpaqueId",
            "advisoryOpaqueId",
            "severity",
            "disclosureState",
            "publicSafeSummary",
            "privateRecordDigest",
            "publicProjectionDigest"
          ],
          "properties": {
            "incidentOpaqueId": {
              "$ref": "#/$defs/componentId"
            },
            "advisoryOpaqueId": {
              "oneOf": [
                {
                  "$ref": "#/$defs/componentId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "severity": {
              "enum": [
                "low",
                "moderate",
                "high",
                "critical"
              ]
            },
            "disclosureState": {
              "enum": [
                "protected-embargoed",
                "public-safe-pre-disclosure",
                "disclosed"
              ]
            },
            "publicSafeSummary": {
              "$ref": "#/$defs/safeText"
            },
            "privateRecordDigest": {
              "$ref": "#/$defs/digest"
            },
            "publicProjectionDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerRole",
        "reviewerRole",
        "authorizationDigest"
      ],
      "properties": {
        "ownerRole": {
          "$ref": "#/$defs/componentId"
        },
        "reviewerRole": {
          "oneOf": [
            {
              "$ref": "#/$defs/componentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorizationDigest": {
          "$ref": "#/$defs/nullableDigest"
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submittedAt",
        "decisionAt",
        "deadlineAt",
        "targetTrainId",
        "reviewAt",
        "rationale"
      ],
      "properties": {
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        },
        "decisionAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadlineAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetTrainId": {
          "oneOf": [
            {
              "$ref": "#/$defs/trainId"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "$ref": "#/$defs/safeText"
        }
      }
    },
    "fixRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "stableMilestone",
        "fixId",
        "publicTitle",
        "publicSummary",
        "classification",
        "disposition",
        "releaseLane",
        "severity",
        "risk",
        "affectedScope",
        "source",
        "provenance",
        "security",
        "ownership",
        "schedule",
        "evidence",
        "state",
        "stateTransitions",
        "supersedingFixId",
        "privateRecordDigest",
        "publicProjectionDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "stable-1.0-fix-record"
        },
        "stableMilestone": {
          "const": "1.0"
        },
        "fixId": {
          "$ref": "#/$defs/fixId"
        },
        "publicTitle": {
          "$ref": "#/$defs/safeText"
        },
        "publicSummary": {
          "$ref": "#/$defs/safeText"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "releaseLane": {
          "$ref": "#/$defs/releaseLane"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "risk": {
          "$ref": "#/$defs/risk"
        },
        "affectedScope": {
          "$ref": "#/$defs/affectedScope"
        },
        "source": {
          "$ref": "#/$defs/sourceIdentity"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "security": {
          "$ref": "#/$defs/securityScope"
        },
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "evidence": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "state": {
          "$ref": "#/$defs/fixState"
        },
        "stateTransitions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/stateTransition"
          }
        },
        "supersedingFixId": {
          "oneOf": [
            {
              "$ref": "#/$defs/fixId"
            },
            {
              "type": "null"
            }
          ]
        },
        "privateRecordDigest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "publicProjectionDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "coverageCategory": {
      "enum": [
        "accepted-fix",
        "approved-release-metadata",
        "approved-release-tooling",
        "approved-docs-support",
        "merge-context",
        "unaccounted"
      ]
    },
    "candidateCoverageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "category",
        "fixId",
        "evidenceDigest",
        "parentCommits",
        "touchedPaths",
        "mergeResolutionPaths",
        "diffDigest"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/commitOid"
        },
        "category": {
          "$ref": "#/$defs/coverageCategory"
        },
        "fixId": {
          "oneOf": [
            {
              "$ref": "#/$defs/fixId"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceDigest": {
          "$ref": "#/$defs/digest"
        },
        "parentCommits": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/commitOid"
          }
        },
        "touchedPaths": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "mergeResolutionPaths": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "diffDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "releaseTrainObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligationId",
        "obligationType",
        "sourceTrainId",
        "sourceFixIds",
        "status",
        "generatedAt",
        "resolvedAt",
        "evidenceDigest"
      ],
      "properties": {
        "obligationId": {
          "$ref": "#/$defs/componentId"
        },
        "obligationType": {
          "enum": [
            "post-release-main-merge",
            "post-release-develop-merge",
            "hotfix-develop-merge-back",
            "hotfix-follow-up"
          ]
        },
        "sourceTrainId": {
          "$ref": "#/$defs/trainId"
        },
        "sourceFixIds": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fixId"
          }
        },
        "status": {
          "enum": ["open", "resolved"]
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "resolvedAt": {
          "oneOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        },
        "evidenceDigest": {
          "$ref": "#/$defs/nullableDigest"
        }
      }
    },
    "mergeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mergeCommit",
        "firstParent",
        "mergedTip",
        "protectedRef",
        "protectedTip",
        "parentCount",
        "graphVerified",
        "workflowAttestationDigest"
      ],
      "properties": {
        "mergeCommit": {
          "$ref": "#/$defs/commitOid"
        },
        "firstParent": {
          "$ref": "#/$defs/commitOid"
        },
        "mergedTip": {
          "$ref": "#/$defs/commitOid"
        },
        "protectedRef": {
          "enum": ["refs/heads/main", "refs/heads/develop"]
        },
        "protectedTip": {
          "$ref": "#/$defs/commitOid"
        },
        "parentCount": {
