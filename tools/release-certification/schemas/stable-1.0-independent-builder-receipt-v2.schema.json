{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stable-1.0-independent-builder-receipt-v2.schema.json",
  "title": "Crypta Stable 1.0 provider-neutral independent builder receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "releaseId",
    "buildVersion",
    "tag",
    "repositoryIdentity",
    "sourceCommit",
    "sourceRef",
    "stableSupplyChainPolicyDigest",
    "independentReproducibilityPolicyDigest",
    "executionContractDigest",
    "verifierKitDigest",
    "role",
    "providerProfileId",
    "providerProfileDigest",
    "authorityIdentity",
    "builderExecutions",
    "source",
    "materialsDigest",
    "resolutionSnapshotDigest",
    "directInputs",
    "buildTasks",
    "canonicalEnvironment",
    "buildStartedAt",
    "buildCompletedAt",
    "outputsSealedAt",
    "candidateProductAvailableBeforeBuild",
    "subjects",
    "receiptDigest"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "kind": {"const": "stable-1.0-independent-builder-receipt"},
    "releaseId": {"$ref": "#/$defs/releaseId"},
    "buildVersion": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "tag": {"type": "string", "pattern": "^v[1-9][0-9]*$", "maxLength": 32},
    "repositoryIdentity": {"const": "github.com/crypta-network/cryptad"},
    "sourceCommit": {"$ref": "#/$defs/commit"},
    "sourceRef": {"$ref": "#/$defs/sourceRef"},
    "stableSupplyChainPolicyDigest": {"$ref": "#/$defs/digest"},
    "independentReproducibilityPolicyDigest": {"$ref": "#/$defs/digest"},
    "executionContractDigest": {"$ref": "#/$defs/digest"},
    "verifierKitDigest": {"$ref": "#/$defs/digest"},
    "role": {"enum": ["candidate-producer", "independent-verifier"]},
    "providerProfileId": {"$ref": "#/$defs/identifier"},
    "providerProfileDigest": {"$ref": "#/$defs/digest"},
    "authorityIdentity": {"$ref": "#/$defs/authorityIdentity"},
    "builderExecutions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/builderExecution"}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "ref", "treeDigest", "clean"],
      "properties": {
        "commit": {"$ref": "#/$defs/commit"},
        "ref": {"$ref": "#/$defs/sourceRef"},
        "treeDigest": {"$ref": "#/$defs/digest"},
        "clean": {"const": true}
      }
    },
    "materialsDigest": {"$ref": "#/$defs/digest"},
    "resolutionSnapshotDigest": {"$ref": "#/$defs/digest"},
    "directInputs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/directInput"}
    },
    "buildTasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/task"}
    },
    "canonicalEnvironment": {"$ref": "#/$defs/canonicalEnvironment"},
    "buildStartedAt": {"$ref": "#/$defs/timestamp"},
    "buildCompletedAt": {"$ref": "#/$defs/timestamp"},
    "outputsSealedAt": {"$ref": "#/$defs/timestamp"},
    "candidateProductAvailableBeforeBuild": {"const": false},
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/subject"}
    },
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$", "maxLength": 40},
    "releaseId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128},
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$", "maxLength": 160},
    "providerValue": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/-]*$", "maxLength": 512},
    "sourceRef": {"type": "string", "pattern": "^(refs/(heads|tags)/[A-Za-z0-9._/-]+|commit:[0-9a-f]{40})$", "maxLength": 512},
    "timestamp": {"type": "string", "format": "date-time", "maxLength": 32},
    "task": {"type": "string", "pattern": "^:[A-Za-z0-9:_-]+$", "maxLength": 160},
    "authorityIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerType",
        "providerId",
        "controlPlaneId",
        "trustDomainId",
        "organizationId",
        "accountId",
        "projectId",
        "pipelineDefinitionId",
        "pipelineRevision",
        "runId",
        "runAttempt",
        "jobId",
        "stageId",
        "executorControllerId",
        "executorOwnership",
        "workloadIdentityDigest",
        "authorityIdentityDigest"
      ],
      "properties": {
        "providerType": {"$ref": "#/$defs/identifier"},
        "providerId": {"$ref": "#/$defs/providerValue"},
        "controlPlaneId": {"$ref": "#/$defs/providerValue"},
        "trustDomainId": {"$ref": "#/$defs/providerValue"},
        "organizationId": {"$ref": "#/$defs/providerValue"},
        "accountId": {"$ref": "#/$defs/providerValue"},
        "projectId": {"$ref": "#/$defs/providerValue"},
        "pipelineDefinitionId": {"$ref": "#/$defs/providerValue"},
        "pipelineRevision": {"$ref": "#/$defs/digest"},
        "runId": {"$ref": "#/$defs/providerValue"},
        "runAttempt": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "jobId": {"$ref": "#/$defs/providerValue"},
        "stageId": {"$ref": "#/$defs/providerValue"},
        "executorControllerId": {"$ref": "#/$defs/providerValue"},
        "executorOwnership": {"enum": ["provider-hosted", "organization-controlled", "third-party-controlled"]},
        "workloadIdentityDigest": {"$ref": "#/$defs/digest"},
        "authorityIdentityDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "directInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest", "origin", "immutabilityClass", "verificationStatus", "verificationMechanism"],
      "properties": {
        "name": {"enum": ["gradle-wrapper-distribution", "seedrefs-source-archive", "tanuki-wrapper-delta-pack", "windows-wrapper-amd64", "windows-wrapper-arm64"]},
        "digest": {"$ref": "#/$defs/digest"},
        "origin": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+/[A-Za-z0-9._~+/-]+$", "maxLength": 1024},
        "immutabilityClass": {"enum": ["versioned-url", "immutable-git-archive", "immutable-release-asset"]},
        "verificationStatus": {"const": "verified"},
        "verificationMechanism": {"enum": ["gradle-wrapper-checksum", "sha256-before-use"]}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["javaVendor", "javaVersion", "javaBuild", "javaEncoding", "javaArchitecture", "javaInstallationManifestDigest", "javaReleaseFileDigest", "javaIdentityDigest", "gradleWrapperJarDigest", "gradleWrapperPropertiesDigest", "gradleDistributionDigest"],
      "properties": {
        "javaVendor": {"type": "string", "minLength": 1, "maxLength": 128},
        "javaVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "javaBuild": {"type": "string", "minLength": 1, "maxLength": 128},
        "javaEncoding": {"const": "UTF-8"},
        "javaArchitecture": {"enum": ["amd64", "arm64"]},
        "javaInstallationManifestDigest": {"$ref": "#/$defs/digest"},
        "javaReleaseFileDigest": {"$ref": "#/$defs/digest"},
        "javaIdentityDigest": {"$ref": "#/$defs/digest"},
        "gradleWrapperJarDigest": {"$ref": "#/$defs/digest"},
        "gradleWrapperPropertiesDigest": {"$ref": "#/$defs/digest"},
        "gradleDistributionDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "materialIdentities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencyVerificationDigest", "verificationKeyringDigest", "pluginResolutionDigest", "buildLogicDigest", "resolutionSnapshotDigest"],
      "properties": {
        "dependencyVerificationDigest": {"$ref": "#/$defs/digest"},
        "verificationKeyringDigest": {"$ref": "#/$defs/digest"},
        "pluginResolutionDigest": {"$ref": "#/$defs/digest"},
        "buildLogicDigest": {"$ref": "#/$defs/digest"},
        "resolutionSnapshotDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "canonicalEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "timezone", "encoding", "sourceDateEpoch"],
      "properties": {
        "locale": {"enum": ["C", "C.UTF-8"]},
        "timezone": {"const": "UTC"},
        "encoding": {"const": "UTF-8"},
        "sourceDateEpoch": {"type": "integer", "minimum": 0, "maximum": 253402300799}
      }
    },
    "builderExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionId",
        "pipelineDefinitionId",
        "pipelineRevision",
        "runId",
        "runAttempt",
        "jobId",
        "stageId",
        "runnerOs",
        "runnerArchitecture",
        "runnerImageIdentity",
        "runnerImageDigest",
        "runnerImageDigestType",
        "toolchain",
        "materialIdentities",
        "taskSet",
        "taskSetDigest",
        "canonicalEnvironment",
        "directInputsDigest",
        "payloadManifestSetDigest",
        "extractionManifestSetDigest",
        "handoffDigest",
        "subjectSetDigest",
        "subjectKeys",
        "sourceCommit",
        "sourceTreeDigest",
        "materialsDigest",
        "resolutionSnapshotDigest",
        "buildStartedAt",
        "buildCompletedAt",
        "candidateProductAvailableBeforeBuild"
      ],
      "properties": {
        "executionId": {"enum": ["linux-installers", "macos-installer", "portable-apps", "windows-installer"]},
        "pipelineDefinitionId": {"$ref": "#/$defs/providerValue"},
        "pipelineRevision": {"$ref": "#/$defs/digest"},
        "runId": {"$ref": "#/$defs/providerValue"},
        "runAttempt": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "jobId": {"$ref": "#/$defs/providerValue"},
        "stageId": {"$ref": "#/$defs/providerValue"},
        "runnerOs": {"enum": ["linux", "macos", "windows"]},
        "runnerArchitecture": {"const": "amd64"},
        "runnerImageIdentity": {"$ref": "#/$defs/providerValue"},
        "runnerImageDigest": {"$ref": "#/$defs/digest"},
        "runnerImageDigestType": {"enum": ["filesystem-image-sha256", "oci-manifest-sha256", "provider-image-sha256", "hosted-runner-release-identity-sha256"]},
        "toolchain": {"$ref": "#/$defs/toolchain"},
        "materialIdentities": {"$ref": "#/$defs/materialIdentities"},
        "taskSet": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/task"}},
        "taskSetDigest": {"$ref": "#/$defs/digest"},
        "canonicalEnvironment": {"$ref": "#/$defs/canonicalEnvironment"},
        "directInputsDigest": {"$ref": "#/$defs/digest"},
        "payloadManifestSetDigest": {"$ref": "#/$defs/digest"},
        "extractionManifestSetDigest": {"$ref": "#/$defs/digest"},
        "handoffDigest": {"$ref": "#/$defs/digest"},
        "subjectSetDigest": {"$ref": "#/$defs/digest"},
        "subjectKeys": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/subjectKey"}},
        "sourceCommit": {"$ref": "#/$defs/commit"},
        "sourceTreeDigest": {"$ref": "#/$defs/digest"},
        "materialsDigest": {"$ref": "#/$defs/digest"},
        "resolutionSnapshotDigest": {"$ref": "#/$defs/digest"},
        "buildStartedAt": {"$ref": "#/$defs/timestamp"},
        "buildCompletedAt": {"$ref": "#/$defs/timestamp"},
        "candidateProductAvailableBeforeBuild": {"const": false}
      }
    },
    "subjectKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$", "maxLength": 128},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectKey", "fileName", "digest", "size", "payloadManifestDigest", "signatureReceiptDigest", "notarizationReceiptDigest", "extractionEvidenceDigest", "publishedCandidate"],
      "properties": {
        "subjectKey": {"$ref": "#/$defs/subjectKey"},
        "fileName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@/-]*$", "maxLength": 512},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 0, "maximum": 100000000000},
        "payloadManifestDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "signatureReceiptDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "notarizationReceiptDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "extractionEvidenceDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "publishedCandidate": {"type": "boolean"}
      }
    }
  }
}
