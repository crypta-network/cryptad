{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stable-1.0-resolved-dependency-snapshot-v1",
  "title": "Crypta Stable 1.0 resolved dependency snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "sourceCommit", "policyDigest", "configurations", "components", "dependencyVerification", "locking", "materialDigests", "snapshotDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "stable-1.0-resolved-dependency-snapshot"},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$", "maxLength": 40},
    "policyDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
    "configurations": {
      "type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["project", "name", "role", "attributes", "componentIds", "resolutionDigest"],
        "properties": {
          "project": {"type": "string", "pattern": "^:[A-Za-z0-9:_-]*$", "maxLength": 160},
          "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$", "maxLength": 160},
          "role": {"enum": ["runtime", "build", "test", "packaging", "publication"]},
          "attributes": {"$ref": "#/$defs/attributes"},
          "componentIds": {"$ref": "#/$defs/componentIds"},
          "resolutionDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71}
        }
      }
    },
    "components": {
      "type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["componentId", "componentKind", "coordinates", "version", "selectedVariant", "attributes", "roles", "artifactDigest", "verificationStatus", "changing", "direct", "parents"],
        "properties": {
          "componentId": {"type": "string", "pattern": "^pkg:[a-z0-9.+-]+/[A-Za-z0-9._~%+@/?=&-]+$", "maxLength": 512},
          "componentKind": {"enum": ["external-module", "internal-project", "vendored-binary"]},
          "coordinates": {"type": "string", "minLength": 3, "maxLength": 512},
          "version": {"type": "string", "minLength": 1, "maxLength": 128},
          "selectedVariant": {"type": "string", "minLength": 1, "maxLength": 256},
          "attributes": {"$ref": "#/$defs/attributes"},
          "roles": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["runtime", "build", "test", "packaging", "publication"]}},
          "artifactDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
          "verificationStatus": {"enum": ["verified", "authenticated-first-party", "unverified"]},
          "changing": {"type": "boolean"},
          "direct": {"type": "boolean"},
          "parents": {"$ref": "#/$defs/componentIds"}
        }
      }
    },
    "dependencyVerification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "metadataDigest", "keyringDigest", "keyringKeysDigest"],
      "properties": {
        "status": {"enum": ["verified", "failed"]},
        "metadataDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
        "keyringDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
        "keyringKeysDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71}
      }
    },
    "locking": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "snapshotMode", "lockDigest"],
      "properties": {
        "status": {"enum": ["locked", "authenticated-snapshot", "unlocked", "drifted"]},
        "snapshotMode": {"enum": ["gradle-locking", "authenticated-resolution-snapshot"]},
        "lockDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71}
      }
    },
    "materialDigests": {
      "type": "object", "additionalProperties": false,
      "required": ["gradleWrapperJar", "gradleWrapperProperties", "gradleDistribution", "versionCatalog", "repositoryConfiguration", "verificationMetadata", "verificationKeyring", "buildLogic", "pluginResolution", "testResolution", "rawResolutionExport"],
      "properties": {
        "gradleWrapperJar": {"$ref": "#/$defs/digest"}, "gradleWrapperProperties": {"$ref": "#/$defs/digest"},
        "gradleDistribution": {"$ref": "#/$defs/digest"}, "versionCatalog": {"$ref": "#/$defs/digest"},
        "repositoryConfiguration": {"$ref": "#/$defs/digest"}, "verificationMetadata": {"$ref": "#/$defs/digest"},
        "verificationKeyring": {"$ref": "#/$defs/digest"}, "buildLogic": {"$ref": "#/$defs/digest"},
        "pluginResolution": {"$ref": "#/$defs/digest"}, "testResolution": {"$ref": "#/$defs/digest"},
        "rawResolutionExport": {"$ref": "#/$defs/digest"}
      }
    },
    "snapshotDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
    "componentIds": {"type": "array", "minItems": 0, "maxItems": 100000, "uniqueItems": true, "items": {"type": "string", "pattern": "^pkg:[a-z0-9.+-]+/[A-Za-z0-9._~%+@/?=&-]+$", "maxLength": 512}},
    "attributes": {"type": "array", "minItems": 0, "maxItems": 64, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 160}, "value": {"type": "string", "minLength": 1, "maxLength": 256}}}}
  }
}
