{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform-api-1.x-history-ledger-v1.schema.json",
  "title": "Platform API 1.x release history ledger",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "repositoryIdentity", "records", "oldestSupportedRecordDigest", "headRecordDigest", "ledgerDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "platform-api-1.x-history-ledger"},
    "repositoryIdentity": {"const": "github.com/crypta-network/cryptad"},
    "records": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/record"}},
    "oldestSupportedRecordDigest": {"$ref": "#/$defs/digest"},
    "headRecordDigest": {"$ref": "#/$defs/digest"},
    "ledgerDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["fileName", "digest", "size"],
      "properties": {
        "fileName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}\\.json$"},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 2, "maximum": 8388608}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["recordId", "releaseId", "buildVersion", "sourceCommit", "sourceRef", "releaseRootDigest", "urlApiVersion", "contractVersion", "contractSnapshot", "baselineRegistryDigest", "compatibilityWindowDigest", "deprecationLedgerDigest", "appMatrixDigest", "predecessorRecordDigest", "provenance", "generatedAt", "publishedAt", "recordStatus", "fixtureOnly", "selfDigest"],
      "properties": {
        "recordId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
        "releaseId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
        "buildVersion": {"type": "integer", "minimum": 1},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sourceRef": {"type": "string", "pattern": "^refs/(?:heads|tags)/[A-Za-z0-9._/-]{1,200}$"},
        "releaseRootDigest": {"$ref": "#/$defs/digest"},
        "urlApiVersion": {"const": "v1"},
        "contractVersion": {"type": "integer", "minimum": 19},
        "contractSnapshot": {"$ref": "#/$defs/binding"},
        "baselineRegistryDigest": {"$ref": "#/$defs/digest"},
        "compatibilityWindowDigest": {"$ref": "#/$defs/digest"},
        "deprecationLedgerDigest": {"$ref": "#/$defs/digest"},
        "appMatrixDigest": {"$ref": "#/$defs/nullableDigest"},
        "predecessorRecordDigest": {"$ref": "#/$defs/nullableDigest"},
        "provenance": {"$ref": "stable-1.0-protected-artifact-provenance-v1.schema.json#/$defs/provenance"},
        "generatedAt": {"type": "string", "format": "date-time"},
        "publishedAt": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
        "recordStatus": {"enum": ["imported", "candidate", "published", "rejected"]},
        "fixtureOnly": {"type": "boolean"},
        "selfDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
