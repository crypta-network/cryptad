{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/crypta-network/cryptad/tools/release-certification/schemas/stable-1.0-support-lifecycle-policy-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "stableMilestone", "component", "profile", "policyVersion", "durationUnit", "lifecycleVocabulary", "normalTransitions", "revocation", "supportWindows", "cardinality", "authorization", "descriptor", "platformApi", "governanceReferences", "publicationOperations", "nonWaivableBlockers", "redactionRequirements"],
  "properties": {
    "schemaVersion": {"const": 1}, "kind": {"const": "stable-1.0-support-lifecycle-policy"}, "stableMilestone": {"const": "1.0"},
    "component": {"const": "stable-lifecycle"}, "profile": {"const": "stable-review"}, "policyVersion": {"type": "integer", "minimum": 1}, "durationUnit": {"const": "days"},
    "lifecycleVocabulary": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "stable-1.0-support-lifecycle-common-v1.schema.json#/$defs/status"}},
    "normalTransitions": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"$ref": "stable-1.0-support-lifecycle-common-v1.schema.json#/$defs/status"}, "to": {"$ref": "stable-1.0-support-lifecycle-common-v1.schema.json#/$defs/status"}}}},
    "revocation": {"type": "object", "additionalProperties": false, "required": ["fromStatuses", "toStatus", "terminal", "requiredAdvisoryFields", "buildRevocationSeparateFromUpdateKeyRevocation", "allowEmergencyNoCurrentStableWhenTipRevoked"], "properties": {"fromStatuses": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "stable-1.0-support-lifecycle-common-v1.schema.json#/$defs/status"}}, "toStatus": {"const": "revoked"}, "terminal": {"const": true}, "requiredAdvisoryFields": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"$ref": "stable-1.0-support-lifecycle-common-v1.schema.json#/$defs/nonEmpty"}}, "buildRevocationSeparateFromUpdateKeyRevocation": {"const": true}, "allowEmergencyNoCurrentStableWhenTipRevoked": {"const": true}}},
    "supportWindows": {"type": "object", "additionalProperties": false, "required": ["minimumFullMaintenanceDuration", "minimumSecurityFixesOnlyDuration", "minimumDeprecationNoticeDuration", "maximumDescriptorAgeDays", "maximumEvidenceAgeDays", "maximumPublicObservationAgeMinutes", "maximumGenesisProofAgeMinutes"], "properties": {"minimumFullMaintenanceDuration": {"type": "integer", "minimum": 1}, "minimumSecurityFixesOnlyDuration": {"type": "integer", "minimum": 1}, "minimumDeprecationNoticeDuration": {"type": "integer", "minimum": 1}, "maximumDescriptorAgeDays": {"type": "integer", "minimum": 1}, "maximumEvidenceAgeDays": {"type": "integer", "minimum": 1}, "maximumPublicObservationAgeMinutes": {"type": "integer", "minimum": 1}, "maximumGenesisProofAgeMinutes": {"type": "integer", "minimum": 1}}},
    "cardinality": {"type": "object", "additionalProperties": false, "required": ["currentStable", "minimumSimultaneouslySupportedBuilds"], "properties": {"currentStable": {"const": 1}, "minimumSimultaneouslySupportedBuilds": {"type": "integer", "minimum": 1}}},
    "authorization": {"type": "object", "additionalProperties": false, "required": ["releaseManagerRole", "securityManagerRole", "maximumValidityHours", "wildcardScopeAllowed"], "properties": {"releaseManagerRole": {"const": "stable-lifecycle-release-manager"}, "securityManagerRole": {"const": "stable-lifecycle-security-manager"}, "maximumValidityHours": {"type": "integer", "minimum": 1}, "wildcardScopeAllowed": {"const": false}}},
    "descriptor": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "updateKeyDocName", "updateKeyIdentityDerivation", "updateKeyIdentityDigest", "maximumEntries", "independentMonotonicEdition", "lastKnownGoodRequired", "historicalCoreInfoImmutable"], "properties": {"schemaVersion": {"const": 1}, "updateKeyDocName": {"const": "support-lifecycle"}, "updateKeyIdentityDerivation": {"const": "sha256-of-raw-public-key-material-without-USK-prefix-docname-or-edition"}, "updateKeyIdentityDigest": {"const": "sha256:b6386982e7eed893448339eed564fcdc140547266b0dc70978ddfa345f6136d7"}, "maximumEntries": {"const": 256}, "independentMonotonicEdition": {"const": true}, "lastKnownGoodRequired": {"const": true}, "historicalCoreInfoImmutable": {"const": true}}},
    "platformApi": {"type": "object", "additionalProperties": false, "required": ["baselineName", "preserveOriginalDeprecationClock", "blockRemovalWhileSupportedBuildOrStableAppDepends", "criticalStableRemovalWaiverAllowed"], "properties": {"baselineName": {"const": "1.0"}, "preserveOriginalDeprecationClock": {"const": true}, "blockRemovalWhileSupportedBuildOrStableAppDepends": {"const": true}, "criticalStableRemovalWaiverAllowed": {"const": false}}},
    "governanceReferences": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "stable-1.0-support-lifecycle-common-v1.schema.json#/$defs/nonEmpty"}},
    "publicationOperations": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["prepare", "authorize", "insert-or-verify", "verify-publication"]}},
    "nonWaivableBlockers": {"type": "array", "minItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^stable-lifecycle\\."}},
    "redactionRequirements": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"$ref": "stable-1.0-support-lifecycle-common-v1.schema.json#/$defs/nonEmpty"}}
  }
}
