    "artifactDigest": {"$ref": "stable-1.0-dependency-vulnerability-common-v1.schema.json#/$defs/digest"}, "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$", "maxLength": 40}, "sourceRef": {"$ref": "stable-1.0-dependency-vulnerability-common-v1.schema.json#/$defs/sourceRef"},
    "manifestDigest": {"$ref": "stable-1.0-dependency-vulnerability-common-v1.schema.json#/$defs/digest"}, "policyDigest": {"$ref": "stable-1.0-dependency-vulnerability-common-v1.schema.json#/$defs/digest"}, "componentInventoryDigest": {"$ref": "stable-1.0-dependency-vulnerability-common-v1.schema.json#/$defs/nullableDigest"},
    "producerIdentity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}$", "maxLength": 256}, "attestationDigest": {"$ref": "stable-1.0-dependency-vulnerability-common-v1.schema.json#/$defs/digest"}, "provenanceDigest": {"$ref": "stable-1.0-dependency-vulnerability-common-v1.schema.json#/$defs/digest"}
  }
