{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypta.network/schemas/stable-1.0-catalog-drill-receipts-v1.schema.json",
  "title": "Stable 1.0 protected catalog-authority drill receipts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "releaseId",
    "buildVersion",
    "sourceCommit",
    "ceremonyId",
    "keysetDigest",
    "bindings",
    "catalogSubject",
    "protectedEnvironment",
    "approvalRole",
    "requiredApprovals",
    "recordedApprovals",
    "fixtureOnly",
    "operational",
    "status",
    "drills",
    "bundleDigest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "stable-1.0-catalog-drill-receipts"},
    "releaseId": {"$ref": "#/$defs/identifier"},
    "buildVersion": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ceremonyId": {"$ref": "#/$defs/identifier"},
    "keysetDigest": {"$ref": "#/$defs/digest"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "catalogSubject": {"$ref": "stable-1.0-public-key-transparency-v1.schema.json#/$defs/catalog"},
    "protectedEnvironment": {"const": "stable-1-0-catalog-drill-acceptance"},
    "approvalRole": {"const": "stable-release-manager"},
    "requiredApprovals": {"const": 2},
    "recordedApprovals": {"const": 2},
    "fixtureOnly": {"const": false},
    "operational": {"const": true},
    "status": {"const": "pass"},
    "drills": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/drillReceipt"}
    },
    "bundleDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "maxLength": 40},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protectedReleaseSummaryDigest",
        "protectedReleaseContractDigest",
        "independentReproducibilitySummaryDigest",
        "independentReproducibilityResultDigest",
        "independentSubjectInventoryDigest"
      ],
      "properties": {
        "protectedReleaseSummaryDigest": {"$ref": "#/$defs/digest"},
        "protectedReleaseContractDigest": {"$ref": "#/$defs/digest"},
        "independentReproducibilitySummaryDigest": {"$ref": "#/$defs/digest"},
        "independentReproducibilityResultDigest": {"$ref": "#/$defs/digest"},
        "independentSubjectInventoryDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "drillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drillType",
        "status",
        "completedAt",
        "evidenceDigests",
        "receiptDigest"
      ],
      "properties": {
        "drillType": {
          "enum": [
            "planned-catalog-key-rotation",
            "compromised-catalog-key-recovery",
            "app-signing-key-rotation",
            "reviewer-key-rotation",
            "emergency-replacement-catalog",
            "catalog-rollback"
          ]
        },
        "status": {"const": "pass"},
        "completedAt": {"$ref": "#/$defs/timestamp"},
        "evidenceDigests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest"}
        },
        "receiptDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
