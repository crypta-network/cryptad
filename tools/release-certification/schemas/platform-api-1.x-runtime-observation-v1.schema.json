{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform-api-1.x-runtime-observation-v1.schema.json",
  "title": "Bounded Platform API 1.x runtime compatibility observation",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "observationId", "releaseId", "buildVersion", "sourceCommit", "releaseRootDigest", "contractVersion", "contractSnapshotDigest", "appSubjectsDigest", "baselineIds", "workflowPath", "runId", "runAttempt", "startedAt", "completedAt", "status", "partial", "fixtureOnly", "longDurationSoak", "representativeChecks", "authorizationFailureChecks", "observationDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "platform-api-1.x-runtime-observation"},
    "observationId": {"$ref": "#/$defs/id"},
    "releaseId": {"$ref": "#/$defs/id"},
    "buildVersion": {"type": "integer", "minimum": 1},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "releaseRootDigest": {"$ref": "#/$defs/digest"},
    "contractVersion": {"type": "integer", "minimum": 19},
    "contractSnapshotDigest": {"$ref": "#/$defs/digest"},
    "appSubjectsDigest": {"$ref": "#/$defs/digest"},
    "baselineIds": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^1\\.(?:0|[1-9][0-9]*)$"}},
    "workflowPath": {"const": ".github/workflows/stable-1.0-platform-api-1x-runtime-observation.yml"},
    "runId": {"type": "integer", "minimum": 1},
    "runAttempt": {"type": "integer", "minimum": 1},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["pass", "fail"]},
    "partial": {"type": "boolean"},
    "fixtureOnly": {"type": "boolean"},
    "longDurationSoak": {"const": false},
    "representativeChecks": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"}},
    "authorizationFailureChecks": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"}},
    "observationDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
