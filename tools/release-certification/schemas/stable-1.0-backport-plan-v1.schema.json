{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crypta-network/cryptad/tools/release-certification/schemas/stable-1.0-backport-plan-v1.schema.json",
  "title": "Cryptad Stable 1.0 backport plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "generatedAt",
    "stableMilestone",
    "trainId",
    "release",
    "repositoryIdentity",
    "policyDigest",
    "intakeDigest",
    "previousQueueDigest",
    "proposedQueueDigest",
    "targetLane",
    "candidateBuild",
    "intendedCandidateCommit",
    "acceptedFixIds",
    "deferredFixIds",
    "rejectedFixIds",
    "provenanceModes",
    "requiredEvidenceIds",
    "carriedObligationIds",
    "noFork",
    "planDigest",
    "status",
    "redaction"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "stable-1.0-backport-plan"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "stableMilestone": {
      "const": "1.0"
    },
    "trainId": {
      "$ref": "stable-1.0-backport-common-v1.schema.json#/$defs/trainId"
    },
    "release": {
      "$ref": "stable-1.0-backport-common-v1.schema.json#/$defs/releaseIdentity"
    },
    "repositoryIdentity": {
      "$ref": "stable-1.0-backport-common-v1.schema.json#/$defs/repositoryIdentity"
    },
    "policyDigest": {
      "$ref": "stable-1.0-backport-common-v1.schema.json#/$defs/digest"
    },
    "intakeDigest": {
      "$ref": "stable-1.0-backport-common-v1.schema.json#/$defs/digest"
    },
    "previousQueueDigest": {
      "$ref": "stable-1.0-backport-common-v1.schema.json#/$defs/nullableDigest"
    },
    "proposedQueueDigest": {
      "$ref": "stable-1.0-backport-common-v1.schema.json#/$defs/digest"
    },
    "targetLane": {
      "enum": [
        "routine-maintenance",
        "security-hotfix"
      ]
    },
    "candidateBuild": {
      "$ref": "stable-1.0-backport-common-v1.schema.json#/$defs/build"
    },
    "intendedCandidateCommit": {
      "$ref": "stable-1.0-backport-common-v1.schema.json#/$defs/nullableCommitOid"
    },
    "acceptedFixIds": {
      "$ref": "#/$defs/fixIds"
    },
    "deferredFixIds": {
      "$ref": "#/$defs/fixIds"
    },
    "rejectedFixIds": {
      "$ref": "#/$defs/fixIds"
    },
    "provenanceModes": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inherited",
          "clean-cherry-pick",
          "manual-conflict-resolution"
        ]
      }
    },
    "requiredEvidenceIds": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "stable-1.0-backport-common-v1.schema.json#/$defs/componentId"
      }
    },
    "carriedObligationIds": {
      "$ref": "#/$defs/obligationIds"
    },
    "noFork": {
      "const": true
    },
    "planDigest": {
      "$ref": "stable-1.0-backport-common-v1.schema.json#/$defs/digest"
    },
    "status": {
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "redaction": {
      "$ref": "stable-1.0-backport-common-v1.schema.json#/$defs/redaction"
    }
  },
  "$defs": {
    "fixIds": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "$ref": "stable-1.0-backport-common-v1.schema.json#/$defs/fixId"
      }
    },
    "obligationIds": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "$ref": "stable-1.0-backport-common-v1.schema.json#/$defs/componentId"
      }
    }
  }
}
