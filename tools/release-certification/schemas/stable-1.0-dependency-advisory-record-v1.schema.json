{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "stable-1.0-dependency-advisory-record-v1.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "sourceId", "sourceRecordId", "sourceRecordDigest", "aliases", "publishedAt", "modifiedAt", "withdrawnAt", "status", "packageClaims", "severityClaims", "references", "recordDigest"],
  "properties": {
    "schemaVersion": {"const": 1}, "kind": {"const": "stable-1.0-dependency-advisory-record"}, "sourceId": {"$ref": "stable-1.0-dependency-vulnerability-common-v1.schema.json#/$defs/identifier"}, "sourceRecordId": {"type": "string", "minLength": 1, "maxLength": 256}, "sourceRecordDigest": {"$ref": "stable-1.0-dependency-vulnerability-common-v1.schema.json#/$defs/digest"},
    "aliases": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["system", "identifier"], "properties": {"system": {"enum": ["CVE", "GHSA", "OSV", "VENDOR"]}, "identifier": {"type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[A-Z0-9][A-Z0-9._:-]+$"}}}},
    "publishedAt": {"$ref": "stable-1.0-dependency-vulnerability-common-v1.schema.json#/$defs/nullableTimestamp"}, "modifiedAt": {"$ref": "stable-1.0-dependency-vulnerability-common-v1.schema.json#/$defs/timestamp"}, "withdrawnAt": {"$ref": "stable-1.0-dependency-vulnerability-common-v1.schema.json#/$defs/nullableTimestamp"}, "status": {"enum": ["active", "withdrawn", "rejected"]},
    "packageClaims": {
      "type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ecosystem", "purlSelector", "versionScheme", "ranges", "affectedVersions", "fixedVersions", "affectedDigests"],
        "properties": {
          "ecosystem": {"enum": ["Maven", "SemVer", "Debian", "RPM", "JDK", "Git", "Vendored", "Cryptad", "Unknown"]},
          "purlSelector": {"$ref": "stable-1.0-dependency-vulnerability-common-v1.schema.json#/$defs/purl"},
          "versionScheme": {"enum": ["maven", "semver", "debian", "rpm", "jdk", "jdk-runtime-build", "git-exact", "digest-exact", "internal-exact", "unsupported"]},
          "ranges": {
            "type": "array", "minItems": 0, "maxItems": 128, "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["rangeType", "events"],
              "properties": {
                "rangeType": {"enum": ["events", "interval", "exact", "unsupported-blocking"]},
                "events": {
                  "type": "array", "minItems": 0, "maxItems": 128, "uniqueItems": true,
                  "items": {"type": "object", "additionalProperties": false, "required": ["type", "version"], "properties": {"type": {"enum": ["introduced", "fixed", "last-affected", "limit", "exact"]}, "version": {"type": "string", "minLength": 1, "maxLength": 256}}}
                }
              }
            }
          },
          "affectedVersions": {"type": "array", "minItems": 0, "maxItems": 1024, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "fixedVersions": {"type": "array", "minItems": 0, "maxItems": 1024, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "affectedDigests": {"type": "array", "minItems": 0, "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "stable-1.0-dependency-vulnerability-common-v1.schema.json#/$defs/digest"}}
        }
      }
    },
    "severityClaims": {"type": "array", "minItems": 0, "maxItems": 32, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["system", "value", "vector"], "properties": {"system": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$", "maxLength": 64}, "value": {"type": "string", "minLength": 1, "maxLength": 64}, "vector": {"type": ["string", "null"], "minLength": 1, "maxLength": 512}}}},
    "references": {"type": "array", "minItems": 0, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 4096}}, "recordDigest": {"$ref": "stable-1.0-dependency-vulnerability-common-v1.schema.json#/$defs/digest"}
  }
}
