    "absolutePathsProhibited": true,
    "candidateBytesInVerifierKitProhibited": true,
    "candidateDigestsInVerifierKitProhibited": true,
    "credentialsProhibited": true,
    "privateUrisProhibited": true,
    "rawBinaryContentProhibited": true,
    "rawFetchedContentProhibited": true,
    "rawAppDataProhibited": true,
    "unpublishedVulnerabilityDetailsProhibited": true
