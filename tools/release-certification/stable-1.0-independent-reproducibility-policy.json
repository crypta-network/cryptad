    "linux-installers",
    "macos-installer",
    "portable-apps",
    "windows-installer"
  ],
  "requiredExecutionTasks": {
    "linux-installers": [
      ":jpackageInstallerLinuxAll"
    ],
    "macos-installer": [
      ":jpackageInstallerCryptad"
    ],
    "portable-apps": [
      ":dist",
      ":packageUnsignedFirstPartyAppsForIndependentReproducibility"
    ],
    "windows-installer": [
      ":jpackageInstallerWindowsExeCryptad"
    ]
