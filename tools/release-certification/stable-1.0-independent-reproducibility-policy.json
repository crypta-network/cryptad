    "candidateBytesExcludedFromVerifierKit": true,
    "candidateProductDigestsExcludedFromVerifierKit": true,
    "producerReceiptExcludedFromVerifierKit": true,
    "candidateAvailableOnlyAfterExternalOutputsSealed": true,
    "candidateAvailableOnlyAfterExternalReceiptAuthenticated": true
  },
  "independenceRules": {
    "differentProviderRequired": true,
    "differentControlPlaneRequired": true,
    "differentTrustDomainRequired": true,
    "organizationIndependencePolicyBound": true,
    "differentRunRequired": true,
    "differentAttestationRequired": true,
    "producerWorkflowAsVerifierProhibited": true,
    "producerControlledExecutorProhibited": true,
    "mutableWorkflowRevisionProhibited": true,
    "mutableRunnerImageProhibitedWhenProfileRequiresDigest": true,
    "selfAssertedIdentityProhibited": true,
    "operationalProfileRequiredForOperationalSuccess": true
  },
