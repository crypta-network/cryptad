  public static boolean shouldPromoteInLegacyNavigation(String legacyPath) {
    return findByLegacyPath(legacyPath)
        .map(surface -> surface.state() != LegacyAdminRetirementState.PRIMARY_REPLACED)
        .orElse(true);
  }

