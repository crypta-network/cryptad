# Defaults for tools/interop/run-hyphanet-interop-smoke.sh.
#
# Environment variables set by the caller take precedence. The checked-in default uses a verified
# Hyphanet 1506 Debian package because that release contains the baseline runtime jars and wrapper
# config needed to launch the node reproducibly on Linux CI.

HYPHANET_BASELINE_VERSION="${HYPHANET_BASELINE_VERSION:-${HYPHANET_BUILD:-1506}}"
HYPHANET_BASELINE_JAR="${HYPHANET_BASELINE_JAR:-}"

# Compatibility aliases for older local invocations and for the verified .deb extraction path.
HYPHANET_VERSION="${HYPHANET_VERSION:-0.7.5}"
HYPHANET_BUILD="${HYPHANET_BUILD:-$HYPHANET_BASELINE_VERSION}"
HYPHANET_RELEASE_TAG="${HYPHANET_RELEASE_TAG:-build01506}"
HYPHANET_DEB_ASSET="${HYPHANET_DEB_ASSET:-freenet_0.7.5+1506-1_amd64.deb}"
HYPHANET_DEB_SHA256="${HYPHANET_DEB_SHA256:-${HYPHANET_BASELINE_SHA256:-b97d04d8a8f34d8e168e296de82e74dc527a6a02b2aa98c46d1fe9d76e2d1ee3}}"
HYPHANET_RELEASE_URL="${HYPHANET_RELEASE_URL:-${HYPHANET_BASELINE_URL:-https://github.com/hyphanet/fred/releases/download/${HYPHANET_RELEASE_TAG}/${HYPHANET_DEB_ASSET}}}"

HYPHANET_BASELINE_URL="${HYPHANET_BASELINE_URL:-$HYPHANET_RELEASE_URL}"
HYPHANET_BASELINE_SHA256="${HYPHANET_BASELINE_SHA256:-$HYPHANET_DEB_SHA256}"

INTEROP_TIMEOUT_SECONDS="${INTEROP_TIMEOUT_SECONDS:-900}"
INTEROP_EXTENDED_TIMEOUT_SECONDS="${INTEROP_EXTENDED_TIMEOUT_SECONDS:-3600}"
INTEROP_STARTUP_TIMEOUT_SECONDS="${INTEROP_STARTUP_TIMEOUT_SECONDS:-180}"
INTEROP_SKIP_BUILD="${INTEROP_SKIP_BUILD:-0}"
INTEROP_KEEP_WORKDIR="${INTEROP_KEEP_WORKDIR:-0}"
INTEROP_MODE="${INTEROP_MODE:-smoke}"
INTEROP_SOAK_DURATION_SECONDS="${INTEROP_SOAK_DURATION_SECONDS:-300}"
INTEROP_SOAK_POLL_INTERVAL_SECONDS="${INTEROP_SOAK_POLL_INTERVAL_SECONDS:-15}"
INTEROP_WORKDIR="${INTEROP_WORKDIR:-}"
