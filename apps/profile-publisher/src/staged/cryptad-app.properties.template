manifest.version=1
app.id=profile-publisher
app.name=Profile Publisher
app.version=${appVersion}
api.minimumVersion=9
api.maximumTestedVersion=24
api.targetStability=experimental
api.experimentalCapabilitiesAccepted=true
app.exec=bin/profile-publisher.sh
app.ui.mode=static
app.ui.entry=static/index.html
app.permissions=queue.read,queue.write,content.insert.app-document,vault.identities.read,vault.identities.create,vault.identities.use,app.data.read,app.data.write
app.beta.readiness=ready
app.beta.qualityLevel=beta
app.beta.support.owner=crypta-core
app.beta.support.uri=https://github.com/crypta-network/cryptad/issues
app.beta.support.diagnostics=redacted-summary-only
app.beta.ui.emptyState=true
app.beta.ui.errorState=true
app.beta.ui.retryAction=true
app.beta.ui.recoveryAction=true
app.beta.appData=durable-limited
app.beta.backupRestore=operator-supported
app.beta.exportSupported=supported
app.beta.importSupported=supported
app.beta.migrationDryRunSupported=not-applicable
app.beta.accessibility=basic-pass
app.beta.uiConsistency=design-system-pass
app.beta.diagnostics=redacted-summary-only
permissions.rationale.queue.read=Show bounded upload queue summaries for generated profile documents.
permissions.rationale.queue.write=Create insert queue requests for generated profile documents.
permissions.rationale.content.insert.app-document=Publish generated profile documents without local source-path authority.
permissions.rationale.vault.identities.read=List visible identity metadata so the operator can choose a signing grant.
permissions.rationale.vault.identities.create=Request app-owned profile identities when the operator opts in.
permissions.rationale.vault.identities.use=Request bounded profile-document signatures without exporting private identity material.
permissions.rationale.app.data.read=Restore the app-owned profile draft and publish summaries.
permissions.rationale.app.data.write=Save bounded profile draft and publish-history state.
sandbox.mode=restricted-process
sandbox.required=false
app.restart.policy=never
quota.data.bytes=1048576
quota.cache.bytes=1048576
app.data.schema.current=1
app.data.schema.namespaces=profile-draft
app.data.schema.namespace.profile-draft.current=1
