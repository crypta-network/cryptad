manifest.version=1
app.id=feed-reader
app.name=Feed Reader & Publisher
app.version=${appVersion}
api.minimumVersion=9
api.maximumTestedVersion=23
api.targetStability=stable
api.experimentalCapabilitiesAccepted=false
app.exec=bin/feed-reader.sh
app.ui.mode=static
app.ui.entry=static/index.html
app.permissions=content.fetch,content.subscribe,content.insert.app-document,queue.read,queue.write,app.data.read,app.data.write
app.beta.readiness=ready
app.beta.qualityLevel=beta
app.beta.support.owner=crypta-core
app.beta.support.uri=https://example.invalid/crypta/apps/feed-reader/support
app.beta.support.diagnostics=redacted-summary-only
app.beta.ui.emptyState=true
app.beta.ui.errorState=true
app.beta.ui.retryAction=true
app.beta.ui.recoveryAction=true
app.beta.appData=durable
app.beta.backupRestore=export-import
app.beta.exportSupported=supported
app.beta.importSupported=supported
app.beta.migrationDryRunSupported=supported
app.beta.accessibility=basic-pass
app.beta.uiConsistency=design-system-pass
app.beta.diagnostics=redacted-summary-only
permissions.rationale.content.fetch=Fetch configured feed sources without persisting raw fetched bodies.
permissions.rationale.content.subscribe=Create app-scoped subscriptions for operator-selected USK feed sources.
permissions.rationale.content.insert.app-document=Publish generated feed snapshots without local source-path authority.
permissions.rationale.queue.read=Show bounded upload queue summaries for generated feed publications.
permissions.rationale.queue.write=Create insert queue requests for generated feed publications.
permissions.rationale.app.data.read=Restore the app-owned feed list, read state, and draft summaries.
permissions.rationale.app.data.write=Save bounded feed source, subscription, read-state, and draft metadata.
sandbox.mode=restricted-process
sandbox.required=false
app.restart.policy=never
quota.data.bytes=1048576
quota.cache.bytes=2097152
app.data.schema.current=2
app.data.schema.namespaces=ui-state
app.data.schema.namespace.ui-state.current=2
app.data.migrations=ui-state-v1-v2
app.data.migration.ui-state-v1-v2.namespace=ui-state
app.data.migration.ui-state-v1-v2.from=1
app.data.migration.ui-state-v1-v2.to=2
app.data.migration.ui-state-v1-v2.command=bin/migrate-feed-data.sh
app.data.migration.ui-state-v1-v2.rollbackCompatible=false
app.data.migration.ui-state-v1-v2.requiresStopped=true
app.data.migration.ui-state-v1-v2.description=Upgrade Feed Reader UI state to schema v2.
