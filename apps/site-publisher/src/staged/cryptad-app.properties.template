manifest.version=1
app.id=site-publisher
app.name=Site Publisher
app.version=${appVersion}
api.minimumVersion=9
api.maximumTestedVersion=24
api.targetStability=stable
api.targetBaseline=1.0
api.experimentalCapabilitiesAccepted=false
app.exec=bin/site-publisher.sh
app.ui.mode=static
app.ui.entry=static/index.html
app.permissions=queue.read,queue.write,content.insert,app.data.read,app.data.write,content.insert.app-document
app.beta.readiness=ready
app.beta.qualityLevel=beta
app.beta.support.owner=crypta-core
app.beta.support.uri=https://github.com/crypta-network/cryptad/issues
app.beta.support.diagnostics=redacted-summary-only
app.beta.ui.emptyState=true
app.beta.ui.errorState=true
app.beta.ui.retryAction=true
app.beta.ui.recoveryAction=true
app.beta.appData=durable-limited
app.beta.backupRestore=export-import
app.beta.exportSupported=supported
app.beta.importSupported=supported
app.beta.migrationDryRunSupported=supported
app.beta.accessibility=basic-pass
app.beta.uiConsistency=design-system-pass
app.beta.diagnostics=redacted-summary-only
permissions.rationale.queue.read=Show bounded upload queue summaries for site publish progress.
permissions.rationale.queue.write=Create insert queue requests after an explicit site or file publish action.
permissions.rationale.content.insert=Submit operator-selected site files to node-side insert routes.
quota.data.bytes=1048576
quota.cache.bytes=0
permissions.rationale.app.data.read=Read private durable plain-text drafts and export private recovery copies.
permissions.rationale.app.data.write=Commit explicitly previewed draft imports, edits, and guarded local undo.
permissions.rationale.content.insert.app-document=Publish selected literal draft text to a new CHK address only after an explicit action.
app.data.schema.current=1
app.data.schema.namespaces=sharesite-drafts
app.data.schema.namespace.sharesite-drafts.current=1
